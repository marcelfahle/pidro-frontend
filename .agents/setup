#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  printf '\n==> %s\n' "$label"
  time "$@"
}

# Node is supplied by the orb base image. Expo 56 requires Node 22.13+.
node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 13)) throw new Error("Node 22.13+ is required")'

# Chromium runtime dependencies on Debian 12; skip apt entirely on warm snapshots.
required_packages=(
  ca-certificates curl unzip
  libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2
  libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3
  libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6
  libxfixes3 libxkbcommon0 libxrandr2 fonts-liberation fonts-noto-color-emoji
)
missing_packages=()
for package in "${required_packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx 'install ok installed'; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]})); then
  step "Updating apt metadata" sudo apt-get update
  step "Installing Chromium prerequisites" sudo env DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

# Match .github/workflows/frontend-ci.yml without replacing the orb's global Bun.
export BUN_INSTALL="$HOME/.local/share/pidro-orb/bun"
export PATH="$BUN_INSTALL/bin:$PATH"
if [[ ! -x "$BUN_INSTALL/bin/bun" ]] || [[ "$(bun --version)" != "1.3.6" ]]; then
  step "Installing Bun 1.3.6" bash -o pipefail -c 'curl -fsSL https://bun.sh/install | bash -s -- bun-v1.3.6 --no-save'
fi

# Amp and supervised services start in separate non-interactive login shells.
profile_marker="# pidro-frontend orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\${PWD}" == "$repo_root" || "\${PWD}" == "$repo_root/"* ]]; then
  export PATH="$BUN_INSTALL/bin:\$PATH"
fi
EOF
fi

step "Installing locked workspace dependencies" bun install --frozen-lockfile
# postinstall does not rerun when only shared source changes on a stale snapshot.
step "Building the shared package" bun run shared:build
step "Caching Playwright Chromium" node node_modules/playwright/cli.js install chromium

[[ -f packages/mobile/.env ]] || cp -- packages/mobile/.env.example packages/mobile/.env
[[ -f packages/web/.env.local ]] || cp -- packages/web/.env.example packages/web/.env.local

printf '\nFrontend orb setup complete. Backend gameplay services are managed in pidro-backend.\n'
