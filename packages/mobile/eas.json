{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_API_URL": "https://app.pidro.online",
        "EXPO_PUBLIC_WS_URL": "wss://app.pidro.online/socket"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "NODE_OPTIONS": "--require ./scripts/tailwind-v3-resolve.cjs"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "1137091987"
      }
    }
  }
}
