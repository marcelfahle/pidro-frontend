# API Configuration
# For physical-device testing, replace localhost with your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000/socket
EXPO_PUBLIC_APP_ENVIRONMENT=development

# Crash reporting (optional): set to your Sentry project DSN to activate.
EXPO_PUBLIC_SENTRY_DSN=

# Product analytics (optional): tracking stays disabled when the key is empty.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
